# TabletCloud
TABLETCLOUD_BASE_URL=https://api.tabletcloud.com.br
# Fluxo OAuth2 password grant (POST /token) - dados fornecidos pelo painel OEM (oem.tabletcloud.com.br)
TABLETCLOUD_USERNAME=seu_usuario
TABLETCLOUD_PASSWORD=sua_senha
TABLETCLOUD_CLIENT_ID=codigo_do_grupo_economico
TABLETCLOUD_CLIENT_SECRET=senha_do_grupo_economico
# Lista de codigos de filiais separados por virgula (ex: 1,2,3).
# Deixe VAZIO para sincronizar automaticamente TODAS as filiais da conta (GET /filial/get).
TABLETCLOUD_FILIAIS=
# Quantos lotes de filiais (grupos de 20) sao buscados em paralelo na TabletCloud.
# Aumente se houver muitas filiais e o ciclo de sync estiver demorando demais.
TABLETCLOUD_CONCURRENCY=5

# Polgo
POLGO_BASE_URL=https://testews.polgo.com.br/polgo
POLGO_USUARIO=coloque_o_usuario_fornecido_pela_polgo
POLGO_SENHA=coloque_a_senha_fornecida_pela_polgo
# Dados da campanha de sorteio informados pelo time de Onboarding da Polgo
POLGO_CAMPANHA_ANO=2026
POLGO_CAMPANHA_IDENTIFICACAO=COLOQUE_A_IDENTIFICACAO

# Sincronizacao
# Expressao cron de execucao (padrao: a cada 10 minutos)
SYNC_CRON=*/10 * * * *
# Quantos dias olhar para tras na primeira execucao (sem cursor salvo).
# 0 = so o dia de hoje (recomendado para o dia de ativacao real da campanha,
# sem trazer historico retroativo).
SYNC_INITIAL_LOOKBACK_DAYS=0
# Roda uma sincronizacao assim que o servico sobe, alem do cron
SYNC_RUN_ON_STARTUP=true

# HTTP server
PORT=3000
# Chave usada para autorizar o endpoint de trigger manual (header X-API-KEY)
ADMIN_API_KEY=troque_esta_chave

# Banco de dados MySQL - guarda o cursor de sincronizacao e o status de cada
# cupom ja processado, para controle de idempotencia. Precisa ser MySQL de
# verdade (nao arquivo local): hospedagens gerenciadas tipo Hostinger nao
# persistem disco local entre deploys.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coloque_o_nome_do_banco
DB_USER=coloque_o_usuario
DB_PASSWORD=coloque_a_senha

# Log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info
