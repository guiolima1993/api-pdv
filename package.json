{
  "name": "pdv-polgo-bridge",
  "version": "1.0.0",
  "description": "Servico intermediario que le vendas (cupons) do TabletCloud e envia para a Polgo (Documentos Fiscais) para participacao em sorteios da Loteria Federal.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "sync:once": "ts-node-dev --transpile-only --exit src/scripts/runOnce.ts"
  },
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/node-cron": "^3.0.11",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^4.6.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
}
